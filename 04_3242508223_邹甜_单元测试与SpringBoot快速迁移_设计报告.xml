<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>5. 分层组件设计</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Bullet"/></w:pPr><w:r><w:t>• Controller 层：@Controller 处理路由与表单绑定，通过构造器注入业务层；</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Bullet"/></w:pPr><w:r><w:t>• Service 层：接口 + 实现类，@Service 注册 Bean，@Transactional 声明事务，add 方法包含标题合法性校验与默认值设置；</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Bullet"/></w:pPr><w:r><w:t>• DAO 层：MyBatis 接口与 mapper XML 的 namespace 一一对应；</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Bullet"/></w:pPr><w:r><w:t>• 过滤器：@Component 注册 AuthFilter，白名单前缀匹配，未登录请求重定向到 /login。</w:t></w:r></w:p>

<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>6. 测试设计</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Body"/></w:pPr><w:r><w:t>共设计 4 个测试类、34 个用例，覆盖正常流、异常流与边界条件；每个用例通过 @BeforeEach 重建测试数据，Mockito 为每个方法提供全新 Mock，保证原子性与独立性。</w:t></w:r></w:p>

<!-- ===================== 五、实现 ===================== -->
<w:p><w:pPr><w:pStyle w:val="H1"/></w:pPr><w:r><w:t>五、实现</w:t></w:r></w:p>

<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>1. 主启动类实现</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Code"/></w:pPr><w:r><w:t>@SpringBootApplication</w:t><w:br/>
<w:t>@MapperScan("cn.edu.mju.band.dal")</w:t><w:br/>
<w:t>public class TaskApplication {</w:t><w:br/>
<w:t>    public static void main(String[] args) {</w:t><w:br/>
<w:t>        SpringApplication.run(TaskApplication.class, args);</w:t><w:br/>
<w:t>    }</w:t><w:br/>
<w:t>}</w:t></w:r></w:p>

<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>2. 多环境与 MyBatis 自动配置（application.yml 节选）</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Code"/></w:pPr><w:r><w:t>spring:</w:t><w:br/>
<w:t>  profiles:</w:t><w:br/>
<w:t>    active: dev</w:t><w:br/>
<w:t>mybatis:</w:t><w:br/>
<w:t>  mapper-locations: classpath*:mapper/*.xml</w:t><w:br/>
<w:t>  type-aliases-package: cn.edu.mju.band.entity</w:t><w:br/>
<w:t>  configuration:</w:t><w:br/>
<w:t>    map-underscore-to-camel-case: true</w:t><w:br/>
<w:t>    call-setters-on-nulls: true</w:t></w:r></w:p>

<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>3. 业务层合法性校验与默认值实现</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Code"/></w:pPr><w:r><w:t>@Override</w:t><w:br/>
<w:t>@Transactional(rollbackFor = Exception.class)</w:t><w:br/>
<w:t>public void add(Task task) {</w:t><w:br/>
<w:t>    if (task == null || task.getTitle() == null</w:t><w:br/>
<w:t>            || task.getTitle().isBlank()) {</w:t><w:br/>
<w:t>        throw new IllegalArgumentException("任务标题不能为空");</w:t><w:br/>
<w:t>    }</w:t><w:br/>
<w:t>    if (task.getStatus() == null)   task.setStatus(0);</w:t><w:br/>
<w:t>    if (task.getPriority() == null) task.setPriority(2);</w:t><w:br/>
<w:t>    taskDao.insert(task);</w:t><w:br/>
<w:t>}</w:t></w:r></w:p>

<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>4. Mockito 打桩实现（数据库宕机场景节选）</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Code"/></w:pPr><w:r><w:t>@Test</w:t><w:br/>
<w:t>void add_whenDatabaseDown_shouldThrowAndStillApplyDefaults() {</w:t><w:br/>
<w:t>    doThrow(new DataAccessResourceFailureException(</w:t><w:br/>
<w:t>            "Communications link failure"))</w:t><w:br/>
<w:t>            .when(taskDao).insert(any(Task.class));</w:t><w:br/>
<w:t>    assertThrows(DataAccessResourceFailureException.class,</w:t><w:br/>
<w:t>            () -&gt; taskBuss.add(task));</w:t><w:br/>
<w:t>    assertEquals(0, task.getStatus());</w:t><w:br/>
<w:t>    verify(taskDao).insert(any(Task.class));</w:t><w:br/>
<w:t>}</w:t></w:r></w:p>

<w:p><w:pPr><w:pStyle w:val="H2"/></w:pPr><w:r><w:t>5. 环境切换命令</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Code"/></w:pPr><w:r><w:t>java -jar target/task-servlet-demo.jar --spring.profiles.active=test</w:t></w:r></w:p>

